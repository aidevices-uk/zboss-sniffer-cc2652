<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex M.CC2652R1F"
            />
        </when>
    </applicability>
    <project
        title="ZBOSS Sniffer CC2652"
        name="zboss_sniffer_CC26X2R1_LAUNCHXL_nortos_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        cgtVersion="3.2.2"
        connection="TIXDS110_Connection.xml"
        device="Cortex M.CC2652R1F"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="com.ti.SIMPLELINK_CC13XX_CC26XX_SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/kernel/nortos
            -I${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/kernel/nortos/posix
            -gdwarf-3
            -mcpu=cortex-m4
            -march=armv7e-m
            -mthumb
            -mfloat-abi=hard
            -mfpu=fpv4-sp-d16
        "
        linkerBuildOptions="
            -L${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/source
            -L${COM_TI_SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR}/kernel/nortos
            -L${PROJECT_BUILD_DIR}/syscfg
            -lti_utils_build_linker.cmd.genlibs
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        postBuildStep="
            ${CG_TOOL_ROOT}/bin/tiarmobjcopy -O ihex ${BuildArtifactFileName} ${BuildArtifactFileBaseName}.hex
        "
        sysConfigBuildOptions="
            --compiler ticlang
        "
        description="CC2652R1 LaunchPad ZBOSS sniffer for the aidevices.uk TRxSniffer application">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../main_nortos.c" action="copy"/>
        <file path="../zboss_sniffer.c" action="copy"/>
        <file path="../radio_ieee.c" action="copy"/>
        <file path="../radio_ieee.h" action="copy"/>
        <file path="../rx_queue.c" action="copy"/>
        <file path="../rx_queue.h" action="copy"/>
        <file path="../host_protocol.h" action="copy"/>
        <file path="../zboss_sniffer.syscfg" action="copy"/>
        <file path="cc26x2r1_nortos.cmd" action="copy"/>
    </project>
</projectSpec>
